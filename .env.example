MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/orbit-crm?retryWrites=true&w=majority
PORT=5000
# Comma-separated frontend origins when the frontend and API are on different origins.
CLIENT_ORIGIN=http://localhost:5173
API_ENABLED=true
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
