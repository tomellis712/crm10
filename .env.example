# MongoDB Atlas connection string. Never commit the real value.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/orbit-crm?retryWrites=true&w=majority

# Local development only; Vercel supplies its own server runtime.
PORT=5000

# Set this to the frontend URL when frontend/API are on different origins.
# When both are served by the same Vercel project, this can be omitted.
CLIENT_ORIGIN=http://localhost:5173

# Frontend uses the API by default in production.
API_ENABLED=true

# Used only by the optional admin seed script.
ADMIN_NAME=Workspace Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Required for production session cookies.
SESSION_SECRET=replace-with-a-long-random-secret
